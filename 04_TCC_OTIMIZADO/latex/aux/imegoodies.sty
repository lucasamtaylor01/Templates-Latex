\RequirePackage{hyperref}
\ExplSyntaxOn
\DeclareUrlCommand\httpurl{
  \def\UrlLeft##1\UrlRight{
    \regex_match:nnTF{^[[:alpha:]][[:alnum:].+\-]{2,12}://}{##1}
    {\href{##1}{##1}}{\href{http\c_colon_str//##1}{##1}}
  }
}
\ExplSyntaxOff
\robustify{\httpurl}

